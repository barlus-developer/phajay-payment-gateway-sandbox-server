# Configuration for one sandbox application instance. No production payment mode exists.
APP_ENV=production
HTTP_ADDR=:8080
PUBLIC_URL=http://localhost:8080
DATABASE_PATH=data/phajay.db
WEB_DIST_DIR=web/dist
MIGRATIONS_DIR=migrations

# Required: generate with `openssl rand -base64 32` and store outside SQLite.
# Keep this key stable across restarts and backups. Never commit or log it.
MASTER_KEY=

# HTTPS PUBLIC_URL automatically requires Secure session cookies.
# List only the actual reverse proxy's IPs or CIDRs; empty trusts no proxies.
TRUSTED_PROXIES=

# Local callbacks require both this opt-in and APP_ENV=development.
ALLOW_LOCAL_WEBHOOKS=false
SESSION_TTL=24h
PAYMENT_TTL=15m
WEBHOOK_TIMEOUT=10s
WEBHOOK_MAX_ATTEMPTS=8
SHUTDOWN_TIMEOUT=15s
